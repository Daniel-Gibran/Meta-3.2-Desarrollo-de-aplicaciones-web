### ===========================================================================
### RF-09 - VER DETALLE DE UN ROSTER
### ===========================================================================

### [7] GET /rosters/1  ->  200 OK con la lista de jugadores
GET {{baseUrl}}/rosters/1
Accept: application/json

> {%
    client.test("[7] GET /rosters/1 responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[7b] Incluye el arreglo 'jugadores'", function () {
        client.assert(Array.isArray(response.body.data.jugadores),
            "Falta el arreglo jugadores");
        client.assert(response.body.data.jugadores.length === 6,
            "Esperaba 6 jugadores, recibí " + response.body.data.jugadores.length);
    });
    client.test("[7c] Cada jugador trae su rol y su rol_en_roster", function () {
        var bien = response.body.data.jugadores.every(function (j) {
            return typeof j.rol === "string" &&
                   (j.rol_en_roster === "Titular" || j.rol_en_roster === "Suplente");
        });
        client.assert(bien, "Falta rol o rol_en_roster en algún jugador");
    });
    client.test("[7d] No expone los campos técnicos de la tabla intermedia", function () {
        var limpio = response.body.data.jugadores.every(function (j) {
            return j.roster_id === undefined && j.jugador_id === undefined;
        });
        client.assert(limpio, "Se filtraron roster_id o jugador_id al cliente");
    });
%}

###

### [8] GET /rosters/1  ->  el listado de jugadores coincide con el roster
GET {{baseUrl}}/rosters/1/jugadores
Accept: application/json

> {%
    client.test("[8] El subrecurso devuelve los mismos 6 jugadores", function () {
        client.assert(response.body.count === 6, "Esperaba 6, recibí " + response.body.count);
        var detalle = 6;
        client.assert(response.body.count === detalle, "Discrepancia entre roster y subrecurso");
    });
%}

