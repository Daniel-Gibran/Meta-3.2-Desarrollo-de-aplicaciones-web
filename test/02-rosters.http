### ===========================================================================
### RF-11 - ELIMINAR ROSTER
### ===========================================================================

### [18] DELETE /rosters/3  ->  204 No Content
### El roster con id 3 es el "Team Solo Mide" creado en [10].
DELETE {{baseUrl}}/rosters/3
Accept: application/json

> {%
    client.test("[18] DELETE responde 204", function () {
        client.assert(response.status === 204, "Esperaba 204, recibí " + response.status);
    });
    client.test("[18b] La respuesta no tiene cuerpo", function () {
        client.assert(response.body === "" || response.body === null || response.body === undefined,
            "El 204 no debe llevar cuerpo");
    });
%}

###

