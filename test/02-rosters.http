### ===========================================================================
### Meta 3.2 - COLECCIÓN 2 - ROSTERS (RF-07 a RF-11, RN-05)
### ===========================================================================
### Ejecutar DESPUÉS de 00-preparacion.http.
###
###   1-5    RF-08 (listar y filtrar)
###   6-9    RF-09 (detalle con jugadores)
###   10-13  RF-07 (crear)
###   14-17  RF-10 (editar)
###   18-21  RF-11 (eliminar)
###   22-23  RN-05 (los jugadores sobreviven al roster)
###
### NOTA: esta colección crea y elimina rosters. Al terminar, la base queda con
### los 2 rosters iniciales más los que se hayan creado.
### ===========================================================================

@baseUrl = http://localhost:3000/api/v1

### ===========================================================================
### RF-08 - LISTAR ROSTERS
### ===========================================================================

### [1] GET /rosters  ->  200 OK
GET {{baseUrl}}/rosters
Accept: application/json

> {%
    client.test("[1] GET /rosters responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[1b] Trae los 2 rosters iniciales", function () {
        client.assert(response.body.count === 2,
            "Esperaba 2 rosters, recibí " + response.body.count);
    });
    client.test("[1c] Cada roster trae su cantidad de jugadores (RF-08)", function () {
        var todos = response.body.data.every(function (r) {
            return typeof r.cantidadJugadores === "number" &&
                   typeof r.cantidadTitulares === "number";
        });
        client.assert(todos, "Falta cantidadJugadores o cantidadTitulares");
    });
%}

###

### [2] GET /rosters  ->  TL Principal tiene 6 jugadores, 5 de ellos titulares
GET {{baseUrl}}/rosters
Accept: application/json

> {%
    client.test("[2] El conteo de titulares coincide con el detalle", function () {
        var tl = response.body.data.filter(function (r) { return r.nombre === "TL Principal"; })[0];
        client.assert(tl.cantidadJugadores === 6,
            "Esperaba 6 jugadores, recibí " + tl.cantidadJugadores);
        client.assert(tl.cantidadTitulares === 5,
            "Esperaba 5 titulares, recibí " + tl.cantidadTitulares);
    });
%}

###

### [3] GET /rosters?tipo=Principal  ->  200 OK
GET {{baseUrl}}/rosters?tipo=Principal
Accept: application/json

> {%
    client.test("[3] Filtrar por tipo responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[3b] Solo devuelve rosters de ese tipo", function () {
        var todos = response.body.data.every(function (r) { return r.tipo === "Principal"; });
        client.assert(todos, "Se filtró un roster de otro tipo");
        client.assert(response.body.count === 1,
            "Esperaba 1 roster Principal, recibí " + response.body.count);
    });
%}

###

### [4] GET /rosters?temporada=2026  ->  200 OK
GET {{baseUrl}}/rosters?temporada=2026
Accept: application/json

> {%
    client.test("[4] Filtrar por temporada responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[4b] Solo devuelve rosters de esa temporada", function () {
        var todos = response.body.data.every(function (r) { return r.temporada === "2026"; });
        client.assert(todos, "Se filtró un roster de otra temporada");
