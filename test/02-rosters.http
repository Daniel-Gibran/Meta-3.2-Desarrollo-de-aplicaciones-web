### RF-10 - EDITAR ROSTER
### ===========================================================================

### [14] PUT /rosters/2  ->  200 OK
PUT {{baseUrl}}/rosters/2
Content-Type: application/json

{
  "nombre": "TL Academy Renombrado",
  "juego": "League of Legends",
  "tipo": "Academy",
  "temporada": "2027"
}

> {%
    client.test("[14] PUT /rosters/2 responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[14b] El nombre y la temporada se actualizaron", function () {
        var d = response.body.data;
        client.assert(d.nombre === "TL Academy Renombrado", "nombre no actualizado");
        client.assert(d.temporada === "2027", "temporada no actualizada");
    });
%}

