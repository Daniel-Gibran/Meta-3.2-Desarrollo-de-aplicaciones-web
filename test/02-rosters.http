### ===========================================================================
### RF-07 - CREAR ROSTER
### ===========================================================================

### [10] POST /rosters  ->  201 Created
POST {{baseUrl}}/rosters
Content-Type: application/json

{
  "nombre": "Team Solo Mide",
  "juego": "League of Legends",
  "tipo": "Principal",
  "temporada": "2026"
}

> {%
    client.test("[10] POST /rosters responde 201", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
    client.test("[10b] Se guardan todos los campos", function () {
        var d = response.body.data;
        client.assert(d.nombre === "Team Solo Mide", "nombre incorrecto");
        client.assert(d.juego === "League of Legends", "juego incorrecto");
        client.assert(d.tipo === "Principal", "tipo incorrecto");
        client.assert(d.temporada === "2026", "temporada incorrecta");
    });
    client.test("[10c] Viene la cabecera Location", function () {
        client.assert(response.headers["location"] !== undefined, "Falta la cabecera Location");
    });
%}

###

### [11] POST /rosters sin enviar 'juego'  ->  201 con el valor por defecto
POST {{baseUrl}}/rosters
Content-Type: application/json

{
  "nombre": "Roster Sin Juego",
  "tipo": "Academy",
  "temporada": "2027"
}

> {%
    client.test("[11] Sin 'juego' responde 201", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
    client.test("[11b] El juego toma su valor por defecto", function () {
        client.assert(response.body.data.juego === "League of Legends",
            "Esperaba 'League of Legends', recibí " + response.body.data.juego);
    });
%}

###

### [12] POST /rosters con temporada inválida  ->  400 Bad Request
POST {{baseUrl}}/rosters
Content-Type: application/json

{
  "nombre": "Roster Mal",
  "tipo": "Principal",
  "temporada": "abc"
}

> {%
    client.test("[12] Una temporada inválida responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
    client.test("[12b] details señala el campo temporada", function () {
        client.assert(response.body.details.temporada !== undefined,
            "details debería señalar el campo temporada");
    });
%}

