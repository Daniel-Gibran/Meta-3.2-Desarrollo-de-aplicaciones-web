### ===========================================================================
### RN-05 - LOS JUGADORES PERMANECEN AL ELIMINAR UN ROSTER
### ===========================================================================

### [21] Se cuenta cuántos jugadores hay antes de borrar el roster
GET {{baseUrl}}/jugadores
Accept: application/json

> {%
    client.test("[21] Conteo de jugadores ANTES de borrar el roster", function () {
        client.log("Jugadores antes: " + response.body.count);
        client.assert(response.body.count > 0, "Debería haber jugadores");
    });
%}

###

### [22] DELETE /rosters/2  ->  204 (el roster vacío de la colección 3 no lo tocó)
### Antes hay que contar los jugadores DESPUÉS para comparar.
GET {{baseUrl}}/jugadores
Accept: application/json

> {%
    client.test("[22] RN-05: borrar un roster NO borra jugadores", function () {
        // El roster 2 se borró en el paso 18 de esta misma lógica; aquí se
        // comprueba que la colección de jugadores sigue intacta.
        client.log("Jugadores después: " + response.body.count);
        client.assert(response.body.count > 0,
            "RN-05 incumplido: el roster borrado arrastró a los jugadores");
    });
    client.test("[22b] Sigue habiendo los 7 jugadores iniciales", function () {
        var nombres = response.body.data.map(function (j) { return j.nickname; });
        ["Faker", "Impact", "CuVee", "Licorice", "CoreJJ", "Aatrox", "Elyoya"]
            .forEach(function (n) {
                client.assert(nombres.indexOf(n) !== -1, "Falta el jugador " + n);
            });
    });
%}