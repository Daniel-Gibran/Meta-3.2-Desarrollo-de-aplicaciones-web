### ===========================================================================
### FORMATO DE ERROR Y CASOS POCO FRECUENTES
### ===========================================================================

### [18] Todas las respuestas de error tienen la misma forma
GET {{baseUrl}}/jugadores/9999
Accept: application/json

> {%
    client.test("[18] El cuerpo de error tiene siempre la misma forma", function () {
        client.assert(response.body.success === false, "success debe ser false");
        client.assert(typeof response.body.error === "string", "falta error");
        client.assert(typeof response.body.message === "string", "falta message");
        client.assert(response.body.data === undefined, "un error no debe traer data");
    });
%}

