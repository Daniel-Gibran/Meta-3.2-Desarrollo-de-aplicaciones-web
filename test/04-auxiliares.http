### ===========================================================================
### Meta 3.2 - COLECCIÓN 4 - ENDPOINTS AUXILIARES Y CASOS LÍMITE
### ===========================================================================
### Ejecutar DESPUÉS de 00-preparacion.http.
###
###   1-4    Catálogos válidos (GET /roles, /estados, /tipos-roster)
###   5-8    Health check
###   9-13   Conflictos que combinan reglas de negocio
###   14-17  Comportamiento del PUT como reemplazo total
###   18-21  Formato de error y códigos poco frecuentes
### ===========================================================================

@baseUrl = http://localhost:3000/api/v1

# Id del jugador de prueba creado en el escenario [14] de esta misma colección.
@jugadorReemplazo =

### ===========================================================================
### CATÁLOGOS VÁLIDOS
### ===========================================================================

### [1] GET /roles  ->  200 OK
GET {{baseUrl}}/roles
Accept: application/json

> {%
    client.test("[1] GET /roles responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[1b] Devuelve los 5 roles del enunciado", function () {
        var roles = response.body.data;
        ["Top", "Jungle", "Mid", "ADC", "Support"].forEach(function (r) {
            client.assert(roles.indexOf(r) !== -1, "Falta el rol " + r);
        });
        client.assert(roles.length === 5, "Esperaba 5 roles, recibí " + roles.length);
    });
%}

###

### [2] GET /estados  ->  200 OK
GET {{baseUrl}}/estados
Accept: application/json

> {%
    client.test("[2] GET /estados responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[2b] Devuelve activo e inactivo", function () {
        var e = response.body.data;
        client.assert(e.indexOf("activo") !== -1, "Falta 'activo'");
        client.assert(e.indexOf("inactivo") !== -1, "Falta 'inactivo'");
        client.assert(e.length === 2, "Esperaba 2 estados, recibí " + e.length);
    });
%}

###

### [3] GET /tipos-roster  ->  200 OK
GET {{baseUrl}}/tipos-roster
Accept: application/json

> {%
    client.test("[3] GET /tipos-roster responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[3b] Devuelve Principal y Academy", function () {
        var t = response.body.data;
        client.assert(t.indexOf("Principal") !== -1, "Falta 'Principal'");
        client.assert(t.indexOf("Academy") !== -1, "Falta 'Academy'");
    });
%}

###

### [4] Los catálogos coinciden con lo que acepta la API
GET {{baseUrl}}/roles
Accept: application/json

> {%
    client.test("[4] El catálogo documenta exactamente lo que valida el backend", function () {
        // Un jugador con este rol debe aceptarse; es la comprobación cruzada
        // entre el catálogo y la validación real.
        client.assert(response.body.count === 5, "El catálogo cambió");
    });
%}

