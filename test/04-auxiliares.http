### ===========================================================================
### HEALTH CHECK
### ===========================================================================

### [5] GET /health  ->  200 OK
GET {{baseUrl}}/health
Accept: application/json

> {%
    client.test("[5] GET /health responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[5b] El estado es 'activo'", function () {
        client.assert(response.body.status === "activo",
            "Esperaba 'activo', recibí " + response.body.status);
    });
    client.test("[5c] La base de datos está conectada", function () {
        client.assert(response.body.baseDeDatos === "conectada",
            "Esperaba 'conectada', recibí " + response.body.baseDeDatos);
    });
%}

###

### [6] El health check expone las reglas de negocio
GET {{baseUrl}}/health
Accept: application/json

> {%
    client.test("[6] Publica el máximo de titulares (RN-02)", function () {
        client.assert(response.body.reglas.maximoTitularesPorRoster === 5,
            "Esperaba 5, recibí " + response.body.reglas.maximoTitularesPorRoster);
    });
    client.test("[6b] Publica el juego por defecto", function () {
        client.assert(response.body.reglas.juegoPorDefecto === "League of Legends",
            "Esperaba 'League of Legends'");
    });
%}

###

### [7] El health check responde rápido (RNF-03: < 0.5 s)
GET {{baseUrl}}/health
Accept: application/json

> {%
    client.test("[7] RNF-03: la respuesta tarda menos de 500 ms", function () {
        var ms = response.body.latenciaMs;
        client.assert(ms < 500, "La latencia fue de " + ms + " ms, el máximo es 500");
        client.log("Latencia: " + ms + " ms");
    });
%}

###

### [8] GET /health es idempotente
GET {{baseUrl}}/health
Accept: application/json

> {%
    client.test("[8] Dos llamadas seguidas dan el mismo resultado", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
        client.assert(response.body.version === "1.0.0",
            "Esperaba versión 1.0.0, recibí " + response.body.version);
    });
%}

###

### ===========================================================================
### CONFLICTOS QUE COMBINAN REGLAS DE NEGOCIO
### ===========================================================================

### [9] No se puede eliminar un jugador que está en un roster  ->  409
### Faker (id 1) está en los rosters 1 y 2.
DELETE {{baseUrl}}/jugadores/1
Accept: application/json

> {%
    client.test("[9] DELETE de un jugador con asignaciones responde 409", function () {
        client.assert(response.status === 409, "Esperaba 409, recibí " + response.status);
    });
    client.test("[9b] El mensaje explica cómo resolverlo", function () {
        client.assert(response.body.message.indexOf("roster") !== -1,
            "El mensaje debe mencionar los rosters, recibí: " + response.body.message);
        client.assert(response.body.details.solucion !== undefined,
            "details debería indicar la solución");
    });
    client.test("[9c] Indica en qué rosters está el jugador", function () {
        var rosters = response.body.details.rostersIds;
        client.assert(Array.isArray(rosters), "details.rostersIds debería ser un arreglo");
        client.assert(rosters.length >= 1, "Debería listar al menos un roster");
    });
%}

###

### [10] El jugador NO se borró (la operación fue atómica)
GET {{baseUrl}}/jugadores/1
Accept: application/json

> {%
    client.test("[10] Tras el 409 el jugador sigue en el sistema", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
        client.assert(response.body.data.nickname === "Faker", "Esperaba Faker");
    });
%}

###

### [11] Quitado de todos sus rosters, el jugador ya se puede eliminar
DELETE {{baseUrl}}/rosters/1/jugadores/1
Accept: application/json

> {%
    client.test("[11] Se quita a Faker del roster 1", function () {
        client.assert(response.status === 204, "Esperaba 204, recibí " + response.status);
    });
%}

###

### [12] DELETE /rosters/2/jugadores/1  ->  204
DELETE {{baseUrl}}/rosters/2/jugadores/1
Accept: application/json

> {%
    client.test("[12] Se quita a Faker del roster 2", function () {
        client.assert(response.status === 204, "Esperaba 204, recibí " + response.status);
    });
%}

###

### [13] Ahora sí se puede eliminar
DELETE {{baseUrl}}/jugadores/1
Accept: application/json

> {%
    client.test("[13] Sin asignaciones, DELETE responde 204", function () {
        client.assert(response.status === 204, "Esperaba 204, recibí " + response.status);
    });
%}

###

### ===========================================================================
### EL PUT ES UN REEMPLAZO TOTAL
### ===========================================================================

### [14] PUT con todos los campos  ->  200
POST {{baseUrl}}/jugadores
Content-Type: application/json

{
  "nickname": "PruebaReemplazo",
  "nombre_real": "Nombre Completo",
  "pais": "Argentina",
  "rol": "Top",
  "estado": "activo"
}

> {%
    client.test("[14] Se crea el jugador de prueba", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
        client.global.set("jugadorReemplazo", response.body.data.id);
        client.log("Jugador de prueba con id " + response.body.data.id);
    });
%}

###

### [15] PUT omitiendo los campos opcionales  ->  se reinician a null
PUT {{baseUrl}}/jugadores/{{jugadorReemplazo}}
Content-Type: application/json

{
  "nickname": "PruebaReemplazo",
  "rol": "Top"
}

> {%
    client.test("[15] PUT responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[15b] Los campos omitidos vuelven a su valor por defecto", function () {
        var d = response.body.data;
        client.assert(d.nombre_real === null,
            "nombre_real debía reiniciarse a null, recibí " + JSON.stringify(d.nombre_real));
        client.assert(d.pais === null, "pais debía reiniciarse a null");
        client.assert(d.estado === "activo", "estado debía tomar su default 'activo'");
    });
%}

###

### [16] PUT sin nickname  ->  400 (reemplazo total exige los obligatorios)
PUT {{baseUrl}}/jugadores/{{jugadorReemplazo}}
Content-Type: application/json

{
  "rol": "Support"
}

> {%
    client.test("[16] PUT sin nickname responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
%}

