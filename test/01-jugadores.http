### ===========================================================================
### Meta 3.2 - COLECCIÓN 1 - JUGADORES (RF-01 a RF-06, RN-01)
### ===========================================================================
### Ejecutar DESPUÉS de 00-preparacion.http, con el servidor corriendo.
###
### Los escenarios se numeran de forma global en toda la colección:
###   1-6    RF-01, RF-02 (crear y listar)
###   7-10   RF-03 (detalle)
###   11-14  RF-04 (actualizar)
###   15-17  RF-05 (eliminar)
###   18-23  RF-06 (buscar y filtrar)
###   24-26  RN-01 (nickname único)
###
### NOTA: los escenarios 11 y 12 borran al jugador creado en [1]. Si se ejecuta
### la colección dos veces sin volver a preparar la base, el [12] seguirá
### dando 404, que es lo esperado.
### ===========================================================================

@baseUrl = http://localhost:3000/api/v1

# Id que devuelve la creación del escenario [1]. REST Client lo guarda con
# client.global.set() y aquí se reutiliza, para que la colección no dependa de
# un número mágico que cambiaría si los seeders tuvieran más datos.
@jugadorCreado =

### ===========================================================================
### RF-01 - CREAR JUGADOR
### ===========================================================================

### [1] POST /jugadores  ->  201 Created
POST {{baseUrl}}/jugadores
Content-Type: application/json

{
  "nickname": "Rekkles",
  "nombre_real": "Martin Larsson",
  "pais": "Suecia",
  "rol": "ADC",
  "estado": "activo"
}

> {%
    client.test("[1] POST /jugadores responde 201", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
    client.test("[1b] Se crea con id autoincremental", function () {
        var d = response.body.data;
        client.assert(d.id > 7, "El id debe ser mayor que 7, recibí " + d.id);
        client.global.set("jugadorCreado", d.id);
        client.log("Jugador creado con id " + d.id);
    });
    client.test("[1c] Todos los campos se guardan bien", function () {
        var d = response.body.data;
        client.assert(d.nickname === "Rekkles", "nickname incorrecto");
        client.assert(d.nombre_real === "Martin Larsson", "nombre_real incorrecto");
        client.assert(d.pais === "Suecia", "pais incorrecto");
        client.assert(d.rol === "ADC", "rol incorrecto");
        client.assert(d.estado === "activo", "estado incorrecto");
    });
    client.test("[1d] Viene la cabecera Location", function () {
        client.assert(response.headers["location"] !== undefined,
            "Falta la cabecera Location");
    });
%}

###

### [2] POST /jugadores con el mínimo de campos  ->  201 Created
### El estado por defecto es 'activo'.
POST {{baseUrl}}/jugadores
Content-Type: application/json

{
  "nickname": "Santorin",
  "rol": "Support"
}

> {%
    client.test("[2] POST con solo nickname y rol responde 201", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
    client.test("[2b] El estado por defecto es 'activo'", function () {
        client.assert(response.body.data.estado === "activo",
            "Esperaba 'activo', recibí " + response.body.data.estado);
    });
    client.test("[2c] Los campos no enviados quedan en null", function () {
        var d = response.body.data;
        client.assert(d.nombre_real === null, "nombre_real debía ser null");
        client.assert(d.pais === null, "pais debía ser null");
    });
%}

###

### ===========================================================================
### RF-02 - LISTAR JUGADORES
### ===========================================================================

### [3] GET /jugadores  ->  200 OK
GET {{baseUrl}}/jugadores
Accept: application/json

> {%
    client.test("[3] GET /jugadores responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[3b] Trae success y count", function () {
        client.assert(response.body.success === true, "success debe ser true");
        client.assert(typeof response.body.count === "number", "count debe ser numérico");
        client.assert(response.body.count === 9,
            "Esperaba 9 jugadores (7 iniciales + 2 creados), recibí " + response.body.count);
    });
    client.test("[3c] Cada elemento tiene la forma del esquema", function () {
        var j = response.body.data[0];
        client.assert(typeof j.id === "number", "falta id");
        client.assert(typeof j.nickname === "string", "falta nickname");
        client.assert(typeof j.rol === "string", "falta rol");
        client.assert(typeof j.estado === "string", "falta estado");
        client.assert(j.createdAt === undefined, "createdAt no debe exponerse");
    });
%}

###

### [4] GET /jugadores  ->  la respuesta es un arreglo plano con los campos
###     del modelo, sin metadatos internos de Sequelize.
GET {{baseUrl}}/jugadores/1
Accept: application/json

> {%
    client.test("[4] La respuesta no filtra datos internos de Sequelize", function () {
        var j = response.body.data;
        client.assert(j.nickname === "Faker", "nickname incorrecto");
        client.assert(j.updatedAt === undefined, "updatedAt no debe exponerse");
        client.assert(j.dataValues === undefined, "dataValues no debe exponerse");
    });
%}

###

### ===========================================================================
### RF-03 - VER DETALLE DE UN JUGADOR
### ===========================================================================

### [5] GET /jugadores/1  ->  200 OK
GET {{baseUrl}}/jugadores/1
Accept: application/json

> {%
    client.test("[5] GET /jugadores/1 responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[5b] Devuelve el jugador correcto", function () {
        var d = response.body.data;
        client.assert(d.id === 1, "Esperaba id 1, recibí " + d.id);
        client.assert(d.nickname === "Faker", "Esperaba Faker");
    });
%}

###

### [6] GET /jugadores/9999  ->  404 Not Found
GET {{baseUrl}}/jugadores/9999
Accept: application/json

> {%
    client.test("[6] Un id inexistente responde 404", function () {
        client.assert(response.status === 404, "Esperaba 404, recibí " + response.status);
    });
    client.test("[6b] El mensaje explica el motivo", function () {
        client.assert(response.body.success === false, "success debe ser false");
        client.assert(response.body.message.indexOf("9999") !== -1,
            "El mensaje debe mencionar el id, recibí: " + response.body.message);
    });
%}

###

### [7] GET /jugadores/abc  ->  400 Bad Request
GET {{baseUrl}}/jugadores/abc
Accept: application/json

> {%
    client.test("[7] Un id no numérico responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
    client.test("[7b] No se confunde con un 404", function () {
        client.assert(response.status !== 404,
            "Un id mal formado no debe devolverse como 'no encontrado'");
    });
%}

