### ===========================================================================
### RF-04 - EDITAR JUGADOR
### El PUT es un reemplazo total: el cuerpo trae todos los campos.
### ===========================================================================

### [8] PUT /jugadores/2  ->  200 OK
PUT {{baseUrl}}/jugadores/2
Content-Type: application/json

{
  "nickname": "Impact",
  "nombre_real": "Song Eui-jin",
  "pais": "Corea del Sur",
  "rol": "Support",
  "estado": "inactivo"
}

> {%
    client.test("[8] PUT /jugadores/2 responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[8b] El estado se actualizó", function () {
        client.assert(response.body.data.estado === "inactivo",
            "Esperaba 'inactivo', recibí " + response.body.data.estado);
    });
%}

###

### [9] PUT /jugadores/9999  ->  404 Not Found
PUT {{baseUrl}}/jugadores/9999
Content-Type: application/json

{
  "nickname": "NoExiste",
  "rol": "Top"
}

> {%
    client.test("[9] PUT sobre un id inexistente responde 404", function () {
        client.assert(response.status === 404, "Esperaba 404, recibí " + response.status);
    });
%}

###

### [10] PUT /jugadores/2 sin nickname  ->  400 Bad Request
### El PUT es reemplazo total: nickname y rol son obligatorios.
PUT {{baseUrl}}/jugadores/2
Content-Type: application/json

{
  "rol": "Support",
  "estado": "activo"
}

> {%
    client.test("[10] PUT sin nickname responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
    client.test("[10b] details señala el campo faltante", function () {
        client.assert(response.body.details.nickname !== undefined,
            "details debería señalar el campo nickname");
    });
%}

###

### ===========================================================================
### RF-05 - ELIMINAR JUGADOR
### ===========================================================================

### [11] DELETE /jugadores/{{jugadorCreado}}  ->  204 No Content
DELETE {{baseUrl}}/jugadores/{{jugadorCreado}}
Accept: application/json

> {%
    client.test("[11] DELETE responde 204", function () {
        client.assert(response.status === 204, "Esperaba 204, recibí " + response.status);
    });
    client.test("[11b] La respuesta no tiene cuerpo", function () {
        client.assert(response.body === "" || response.body === null || response.body === undefined,
            "El 204 no debe llevar cuerpo, recibí: " + JSON.stringify(response.body));
    });
%}

###

### [12] DELETE /jugadores/{{jugadorCreado}} otra vez  ->  404 Not Found
DELETE {{baseUrl}}/jugadores/{{jugadorCreado}}
Accept: application/json

> {%
    client.test("[12] Borrar dos veces el mismo jugador responde 404", function () {
        client.assert(response.status === 404, "Esperaba 404, recibí " + response.status);
    });
%}

###

### ===========================================================================
### RF-06 - BUSCAR Y FILTRAR
### ===========================================================================

### [13] GET /jugadores?rol=Mid  ->  200 OK
GET {{baseUrl}}/jugadores?rol=Mid
Accept: application/json

> {%
    client.test("[13] Filtrar por rol responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[13b] Solo devuelve jugadores con ese rol", function () {
        var todosMid = response.body.data.every(function (j) { return j.rol === "Mid"; });
        client.assert(todosMid, "Se filtró un jugador que no es Mid");
        client.assert(response.body.count === 1,
            "Esperaba 1 Mid (Faker), recibí " + response.body.count);
    });
%}

###

### [14] GET /jugadores?estado=inactivo  ->  200 OK
GET {{baseUrl}}/jugadores?estado=inactivo
Accept: application/json

> {%
    client.test("[14] Filtrar por estado responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[14b] Solo devuelve jugadores inactivos", function () {
        var todos = response.body.data.every(function (j) { return j.estado === "inactivo"; });
        client.assert(todos, "Se filtró un jugador activo");
    });
%}

###

### [15] GET /jugadores?search=lic  ->  200 OK
### La búsqueda es parcial y no distingue mayúsculas.
GET {{baseUrl}}/jugadores?search=lic
Accept: application/json

> {%
    client.test("[15] Buscar por nickname responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[15b] Encuentra a Licorice con búsqueda parcial", function () {
        client.assert(response.body.count === 1,
            "Esperaba 1 resultado, recibí " + response.body.count);
        client.assert(response.body.data[0].nickname === "Licorice",
            "Esperaba Licorice, recibí " + response.body.data[0].nickname);
    });
%}

###

### [16] GET /jugadores?search=LIC  ->  200 OK (mayúsculas)
GET {{baseUrl}}/jugadores?search=LIC
Accept: application/json

> {%
    client.test("[16] La búsqueda ignora mayúsculas y minúsculas", function () {
        client.assert(response.body.count === 1,
            "Esperaba 1 resultado, recibí " + response.body.count);
        client.assert(response.body.data[0].nickname === "Licorice",
            "Esperaba Licorice, recibí " + response.body.data[0].nickname);
    });
%}

###

### [17] GET /jugadores?search=zzzz  ->  200 OK con lista vacía
GET {{baseUrl}}/jugadores?search=zzzznoexiste
Accept: application/json

> {%
    client.test("[17] Una búsqueda sin resultados devuelve 200 y lista vacía", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
