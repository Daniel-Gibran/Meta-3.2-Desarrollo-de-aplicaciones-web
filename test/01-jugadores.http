###

### [18] GET /jugadores?rol=Capa  ->  400 Bad Request
### Un valor fuera del catálogo es un error del cliente, no una lista vacía.
GET {{baseUrl}}/jugadores?rol=Capa
Accept: application/json

> {%
    client.test("[18] Un rol fuera del catálogo responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
    client.test("[18b] El mensaje indica los valores válidos", function () {
        client.assert(response.body.message.indexOf("Mid") !== -1,
            "El mensaje debe listar los roles válidos, recibí: " + response.body.message);
    });
%}

###

### [19] GET /jugadores?rol=Mid&estado=activo  ->  200 OK
GET {{baseUrl}}/jugadores?rol=Mid&estado=activo
Accept: application/json

> {%
    client.test("[19] Los filtros se combinan", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
        var ok = response.body.data.every(function (j) {
            return j.rol === "Mid" && j.estado === "activo";
        });
        client.assert(ok, "Se filtró un jugador que no cumple ambos filtros");
    });
%}

###

### ===========================================================================
### RN-01 - EL NICKNAME DEBE SER ÚNICO
### ===========================================================================

### [20] POST /jugadores con un nickname ya existente  ->  409 Conflict
POST {{baseUrl}}/jugadores
Content-Type: application/json

{
  "nickname": "Faker",
  "nombre_real": "Impostor",
  "pais": "Desconocido",
  "rol": "Mid"
}

> {%
    client.test("[20] RN-01: nickname duplicado responde 409", function () {
        client.assert(response.status === 409, "Esperaba 409, recibí " + response.status);
    });
    client.test("[20b] El mensaje menciona el conflicto", function () {
        client.assert(response.body.message.indexOf("nickname") !== -1,
            "El mensaje debe mencionar el nickname, recibí: " + response.body.message);
    });
    client.test("[20c] details indica qué jugador lo ocupa", function () {
        client.assert(response.body.details.jugador_id === 1,
            "Esperaba jugador_id 1, recibí " + response.body.details.jugador_id);
    });
%}

###

### [21] POST /jugadores con un rol inválido  ->  400 Bad Request
POST {{baseUrl}}/jugadores
Content-Type: application/json

{
  "nickname": "RolInvalido",
  "rol": "Capa"
}

> {%
    client.test("[21] Un rol fuera del catálogo responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
    client.test("[21b] details señala el campo rol", function () {
        client.assert(response.body.details.rol !== undefined,
            "details debería señalar el campo rol");
    });
%}

###

### [22] POST /jugadores sin nickname ni rol  ->  400 Bad Request
POST {{baseUrl}}/jugadores
Content-Type: application/json

{
  "pais": "Mexico"
}

> {%
    client.test("[22] Sin los campos obligatorios responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
    client.test("[22b] Reporta ambos campos faltantes", function () {
        client.assert(response.body.details.nickname !== undefined, "falta nickname");
        client.assert(response.body.details.rol !== undefined, "falta rol");
    });
%}

###

### [23] PUT /jugadores/3 con el nickname de otro jugador  ->  409 Conflict
PUT {{baseUrl}}/jugadores/3
