###

### [17] POST /rosters/2/jugadores - mismo jugador, distinto roster  ->  201
### El jugador 3 (CuVee) está en el roster 1; se agrega al roster 2.
POST {{baseUrl}}/rosters/2/jugadores
Content-Type: application/json

{
  "jugador_id": 3,
  "rol_en_roster": "Suplente"
}

> {%
    client.test("[17] RN-04: el mismo jugador puede estar en varios rosters", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
%}

###

### [18] Ese jugador aparece en ambos rosters
GET {{baseUrl}}/rosters/2/jugadores
Accept: application/json

> {%
    client.test("[18] CuVee aparece en el roster 2", function () {
        var cuvee = response.body.data.filter(function (j) {
            return j.nickname === "CuVee";
        })[0];
        client.assert(cuvee !== undefined, "CuVee no está en el roster 2");
        client.assert(cuvee.rol_en_roster === "Suplente", "Esperaba Suplente");
    });
%}

