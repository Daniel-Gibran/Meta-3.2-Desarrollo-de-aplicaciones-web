### [6] POST /rosters/9999/jugadores  ->  404 si el roster no existe
POST {{baseUrl}}/rosters/9999/jugadores
Content-Type: application/json

{
  "jugador_id": 1,
  "rol_en_roster": "Titular"
}

> {%
    client.test("[6] Un roster inexistente responde 404", function () {
        client.assert(response.status === 404, "Esperaba 404, recibí " + response.status);
