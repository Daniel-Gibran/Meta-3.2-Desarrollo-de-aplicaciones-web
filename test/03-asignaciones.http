### ===========================================================================
### RF-13 - QUITAR UN JUGADOR DE UN ROSTER
### ===========================================================================

### [23] DELETE /rosters/1/jugadores/7  ->  204 No Content
DELETE {{baseUrl}}/rosters/1/jugadores/7
Accept: application/json

> {%
    client.test("[23] Quitar jugador responde 204", function () {
        client.assert(response.status === 204, "Esperaba 204, recibí " + response.status);
    });
    client.test("[23b] La respuesta no tiene cuerpo", function () {
        client.assert(response.body === "" || response.body === null || response.body === undefined,
            "El 204 no debe llevar cuerpo");
    });
%}

