### ===========================================================================
### RF-12 - CAMBIAR EL ROL DE UN JUGADOR DENTRO DE UN ROSTER
### ===========================================================================

### [19] PUT /rosters/1/jugadores/1  ->  200 (ya era Titular, se mantiene)
### El contador de RN-02 EXCLUYE al propio jugador: si lo contara, un titular
### no podría "ascender" a sí mismo bloqueado por su propio registro.
PUT {{baseUrl}}/rosters/1/jugadores/1
Content-Type: application/json

{
  "rol_en_roster": "Titular"
}

> {%
    client.test("[19] Mantener el mismo rol responde 200", function () {
        client.assert(response.status === 200, "Esperaba 200, recibí " + response.status);
    });
    client.test("[19b] Sigue siendo Titular", function () {
        client.assert(response.body.data.rol_en_roster === "Titular",
            "Esperaba Titular, recibí " + response.body.data.rol_en_roster);
    });
%}

###

### [20] PUT /rosters/2/jugadores/5 - promover a titular  ->  409 RN-03
### CoreJJ es Support y el roster 2 ya tiene a Impact como titular Support.
PUT {{baseUrl}}/rosters/2/jugadores/5
Content-Type: application/json

{
  "rol_en_roster": "Titular"
}

> {%
    client.test("[20] RN-03 también se aplica al cambiar de rol", function () {
        client.assert(response.status === 409, "Esperaba 409, recibí " + response.status);
    });
    client.test("[20b] Sigue siendo Suplente tras el rechazo", function () {
        var r = client.request;
        client.assert(response.body.data === undefined || response.body.data === null,
            "Un 409 no debe devolver el recurso actualizado");
    });
%}

