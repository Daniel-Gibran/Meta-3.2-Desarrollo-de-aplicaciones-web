### ===========================================================================
### RN-02 - MÁXIMO DE 5 TITULARES POR ROSTER
### ===========================================================================
### El roster 1 ya tiene 5 titulares de origen, así que cualquier tentativa de
### sumar un sexto titular debe ser rechazada con 409.
### Se usa a CoreJJ (id 5), que es el único jugador que NO está en el roster 1.
### ===========================================================================

### [8] POST /rosters/1/jugadores como Titular  ->  409 Conflict
POST {{baseUrl}}/rosters/1/jugadores
Content-Type: application/json

{
  "jugador_id": 5,
  "rol_en_roster": "Titular"
}

> {%
    client.test("[8] RN-02: un sexto titular responde 409", function () {
        client.assert(response.status === 409, "Esperaba 409, recibí " + response.status);
    });
    client.test("[8b] El mensaje menciona el máximo de titulares", function () {
        client.assert(response.body.message.indexOf("5") !== -1,
            "El mensaje debe mencionar el máximo, recibí: " + response.body.message);
    });
    client.test("[8c] details indica cuántos titulares hay", function () {
        client.assert(response.body.details.maximoTitulares === 5,
            "Esperaba maximoTitulares 5, recibí " + response.body.details.maximoTitulares);
        client.assert(response.body.details.titularesActuales === 5,
            "Esperaba titularesActuales 5, recibí " + response.body.details.titularesActuales);
    });
%}

###

### [9] El mismo jugador SÍ puede entrar como Suplente
POST {{baseUrl}}/rosters/1/jugadores
Content-Type: application/json

{
  "jugador_id": 5,
  "rol_en_roster": "Suplente"
}

> {%
    client.test("[9] RN-02 no aplica a los suplentes", function () {
        client.assert(response.status === 201,
            "Esperaba 201, recibí " + response.status);
    });
    client.test("[9b] Se guardó como Suplente", function () {
        client.assert(response.body.data.rol_en_roster === "Suplente",
            "Esperaba Suplente, recibí " + response.body.data.rol_en_roster);
    });
%}

###

### [10] POST /rosters/1/jugadores con un jugador ya asignado  ->  409
### Asignar dos veces al mismo jugador al mismo roster viola RN-04.
POST {{baseUrl}}/rosters/1/jugadores
Content-Type: application/json

{
  "jugador_id": 1,
  "rol_en_roster": "Titular"
}

> {%
    client.test("[10] Un jugador ya asignado a este roster responde 409", function () {
        client.assert(response.status === 409, "Esperaba 409, recibí " + response.status);
    });
    client.test("[10b] El mensaje lo dice claramente", function () {
        client.assert(response.body.message.indexOf("ya está asignado") !== -1,
            "Esperaba un mensaje de asignación duplicada, recibí: " + response.body.message);
    });
%}

###

### [11] GET /rosters/1  ->  el contador de titulares sigue en 5
GET {{baseUrl}}/rosters/1
Accept: application/json

> {%
    client.test("[11] RN-02: los intentos fallidos no alteraron el roster", function () {
        var titulares = response.body.data.jugadores.filter(function (j) {
            return j.rol_en_roster === "Titular";
        });
        client.assert(titulares.length === 5,
            "Esperaba 5 titulares, recibí " + titulares.length);
    });
%}

###

### ===========================================================================
### RN-03 - NO PUEDE HABER DOS TITULARES CON EL MISMO ROL
### ===========================================================================
### El jugador 1 (Faker, Mid) ya es titular del roster 2 en el paso [4].
### Intentar poner a otro Mid como titular del mismo roster debe dar 409.
### El jugador 2 es Support, así que primero se mete a un Support.
### ===========================================================================

### [12] POST /rosters/2/jugadores - Support titular (pasa, aún hay cupo)
POST {{baseUrl}}/rosters/2/jugadores
Content-Type: application/json

{
  "jugador_id": 2,
  "rol_en_roster": "Titular"
}

> {%
    client.test("[12] Asignar un Support titular responde 201", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
%}

###

### [13] POST /rosters/2/jugadores - otro Support titular  ->  409 RN-03
### CoreJJ (id 5) es Support y ya entró como suplente en [9]; aquí se intenta
### promoverlo a titular. El conflicto real es que ya hay un titular Support.
POST {{baseUrl}}/rosters/2/jugadores
Content-Type: application/json

{
  "jugador_id": 5,
  "rol_en_roster": "Titular"
}

> {%
    client.test("[13] RN-03: dos titulares con el mismo rol responde 409", function () {
        client.assert(response.status === 409, "Esperaba 409, recibí " + response.status);
    });
    client.test("[13b] El mensaje menciona el rol en conflicto", function () {
        client.assert(response.body.message.indexOf("Support") !== -1,
            "El mensaje debe mencionar el rol, recibí: " + response.body.message);
    });
    client.test("[13c] details muestra cuál jugador ocupa el rol", function () {
        client.assert(response.body.details.rol === "Support",
            "Esperaba rol Support, recibí " + response.body.details.rol);
        client.assert(response.body.details.jugadorActual.nickname === "Impact",
            "Esperaba que el conflicto fuera con Impact, recibí " +
            response.body.details.jugadorActual.nickname);
    });
%}

###

### [14] El mismo Support SÍ puede entrar como Suplente
POST {{baseUrl}}/rosters/2/jugadores
Content-Type: application/json

{
  "jugador_id": 5,
  "rol_en_roster": "Suplente"
}

> {%
    client.test("[14] RN-03 no aplica a los suplentes", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
%}

###

### [15] GET /rosters/2  ->  solo hay un titular Support
GET {{baseUrl}}/rosters/2
Accept: application/json

> {%
    client.test("[15] RN-03: el roster mantiene un solo titular por rol", function () {
        var titulares = response.body.data.jugadores.filter(function (j) {
            return j.rol_en_roster === "Titular";
        });
        var roles = titulares.map(function (j) { return j.rol; });
        var repetidos = roles.filter(function (r, i) { return roles.indexOf(r) !== i; });
        client.assert(repetidos.length === 0,
            "Hay roles de titular repetidos: " + repetidos.join(", "));
    });
%}

