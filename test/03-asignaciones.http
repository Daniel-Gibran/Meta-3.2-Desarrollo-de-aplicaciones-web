### ===========================================================================
### RF-12 - ASIGNAR UN JUGADOR A UN ROSTER
### ===========================================================================

### [4] POST /rosters/2/jugadores  ->  201 Created
POST {{baseUrl}}/rosters/2/jugadores
Content-Type: application/json

{
  "jugador_id": 1,
  "rol_en_roster": "Titular"
}

> {%
    client.test("[4] Asignar jugador responde 201", function () {
        client.assert(response.status === 201, "Esperaba 201, recibí " + response.status);
    });
    client.test("[4b] La asignación refleja lo enviado", function () {
        var d = response.body.data;
        client.assert(d.roster_id === 2, "roster_id incorrecto, recibí " + d.roster_id);
        client.assert(d.jugador_id === 1, "jugador_id incorrecto");
        client.assert(d.rol_en_roster === "Titular", "rol_en_roster incorrecto");
    });
    client.test("[4c] Incluye el jugador completo", function () {
        client.assert(response.body.data.jugador.nickname === "Faker",
            "Esperaba a Faker en el detalle");
    });
%}

###

### [5] POST /rosters/2/jugadores  ->  404 si el jugador no existe
POST {{baseUrl}}/rosters/2/jugadores
Content-Type: application/json

{
  "jugador_id": 9999,
  "rol_en_roster": "Titular"
}

> {%
    client.test("[5] Un jugador inexistente responde 404", function () {
        client.assert(response.status === 404, "Esperaba 404, recibí " + response.status);
    });
    client.test("[5b] El mensaje menciona el id del jugador", function () {
        client.assert(response.body.message.indexOf("9999") !== -1,
            "El mensaje debe mencionar el id, recibí: " + response.body.message);
    });
%}

