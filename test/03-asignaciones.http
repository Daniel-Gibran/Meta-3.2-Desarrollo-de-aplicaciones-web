###

### [7] POST /rosters/2/jugadores  ->  400 si el rol_en_roster no es válido
POST {{baseUrl}}/rosters/2/jugadores
Content-Type: application/json

{
  "jugador_id": 2,
  "rol_en_roster": "Capitan"
}

> {%
    client.test("[7] Un rol_en_roster inválido responde 400", function () {
        client.assert(response.status === 400, "Esperaba 400, recibí " + response.status);
    });
    client.test("[7b] details señala el campo rol_en_roster", function () {
        client.assert(response.body.details.rol_en_roster !== undefined,
            "details debería señalar el campo rol_en_roster");
    });
%}

