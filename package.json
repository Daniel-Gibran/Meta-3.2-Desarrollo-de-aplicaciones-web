{
  "name": "meta3-2-rest-api-jugadores-rosters",
  "version": "1.0.0",
  "description": "REST API para gestionar jugadores y rosters de equipos de eSports (Node.js, Express, Sequelize, MySQL)",
  "main": "server.js",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo:all": "sequelize-cli db:seed:undo:all",
    "db:reset": "npm run migrate:undo:all && npm run migrate && npm run seed",
    "test": "node tools/verificar-entregables.mjs",
    "test:openapi": "node tools/validar-openapi.mjs"
  },
  "keywords": [
    "express",
    "rest-api",
    "sequelize",
    "mysql",
    "openapi"
  ],
  "author": "Daniel Gibran Alvarez Armienta",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.3"
  }
}
